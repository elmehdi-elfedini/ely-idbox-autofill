{
    "manifest_version": 3,
    "name": "ELY-IDBox — Remplissage automatique",
    "version": "2.3",
    "description": "Lit le fichier Extracted data.csv et remplit automatiquement les formulaires.",
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "permissions": ["sidePanel", "scripting", "storage"],
    "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["http://*/*", "https://*/*"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_title": "IdBox — Remplissage automatique",
      "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png"
      }
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
